{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zhilume.local/contracts/worker-message/3.0",
  "title": "WorkerMessage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "messageId",
    "type",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": "3.0"
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "type": {
      "enum": [
        "hello",
        "heartbeat",
        "welcome",
        "task.assign",
        "task.inputs_ready",
        "task.accepted",
        "task.progress",
        "task.result_ready",
        "task.failed",
        "task.cancelled",
        "task.cancel",
        "task.commit_ack",
        "lease.renewed",
        "drain",
        "error"
      ]
    },
    "jobId": {
      "type": "string",
      "maxLength": 100
    },
    "attemptId": {
      "type": "string",
      "maxLength": 100
    },
    "leaseId": {
      "type": "string",
      "maxLength": 100
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^task\\."
          }
        }
      },
      "then": {
        "required": [
          "jobId",
          "attemptId",
          "leaseId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "workerId",
              "capabilities",
              "executionSpecs",
              "deployment",
              "activeAttempts"
            ],
            "properties": {
              "executionSpecs": {
                "type": "array",
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "spec"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "image",
                        "speech",
                        "video"
                      ]
                    },
                    "spec": {
                      "type": "object",
                      "required": [
                        "profileId",
                        "modelId",
                        "workflowRevision",
                        "identity"
                      ]
                    }
                  }
                }
              },
              "deployment": {
                "type": "object",
                "required": [
                  "capacity",
                  "resourceIds"
                ],
                "additionalProperties": false,
                "properties": {
                  "capacity": {
                    "const": 1
                  },
                  "resourceIds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
